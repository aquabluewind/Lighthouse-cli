10 REM ******************************
20 REM *   O L I O N  オリオン      *
30 REM *   ORION STAR FIGHTER       *
40 REM *   FOR NEC PC-6001          *
50 REM *   N60-BASIC                *
60 REM ******************************
70 SCREEN 0,1:WIDTH 32,16:CLS
80 COLOR 7,0
90 :
100 REM === TITLE SCREEN ===
110 CLS
120 COLOR 6,0
130 LOCATE 8,2:PRINT "**  OLION  **"
140 LOCATE 6,3:PRINT "オリオン シューター"
150 COLOR 7,0
160 LOCATE 5,5:PRINT "---  NEC PC-6001  ---"
170 COLOR 3,0
180 LOCATE 4,7:PRINT "あなたはオリオン号の"
190 LOCATE 4,8:PRINT "パイロット！"
200 LOCATE 4,9:PRINT "てきをたおせ！"
210 COLOR 5,0
220 LOCATE 2,11:PRINT "Z/X:いどう  SPC:はっしゃ"
230 COLOR 7,0
240 LOCATE 9,14:PRINT "SPC:スタート"
250 :
260 K$=INKEY$:IF K$<>CHR$(32) THEN 260
270 :
300 REM === INITIALIZE GAME ===
310 SCORE=0:LIVES=3:LEVEL=1:FRAME=0
320 PX=15:PY=14
330 BX=0:BY=0:BF=0
340 DIM EX(5),EY(5),EF(5)
350 FOR I=0 TO 4
360   EX(I)=INT(RND(1)*28)+2
370   EY(I)=INT(RND(1)*10)+1
380   EF(I)=1
390 NEXT I
400 CLS
410 :
500 REM === MAIN GAME LOOP ===
510 K$=INKEY$
520 :
530 REM -- INPUT --
540 IF K$="Z" OR K$="z" THEN GOSUB 6000:PX=PX-1:IF PX<1 THEN PX=1
550 IF K$="X" OR K$="x" THEN GOSUB 6100:PX=PX+1:IF PX>30 THEN PX=30
560 IF K$=CHR$(32) AND BF=0 THEN BX=PX:BY=PY-1:BF=1
570 :
580 REM -- ERASE OLD PLAYER --
590 LOCATE PX,PY:PRINT " "
600 :
610 REM -- MOVE BULLET --
620 IF BF=1 THEN LOCATE BX,BY:PRINT " "
630 IF BF=1 THEN BY=BY-1
640 IF BY<1 THEN BF=0
650 :
660 REM -- MOVE ENEMIES (EVERY 4 FRAMES) --
670 FRAME=FRAME+1
680 IF FRAME MOD 4 <> 0 THEN GOTO 760
690 FOR I=0 TO 4
700   IF EF(I)=0 THEN GOTO 730
710   LOCATE EX(I),EY(I):PRINT " "
720   EY(I)=EY(I)+1
730 NEXT I
740 :
760 REM -- CHECK ENEMY OFF SCREEN --
770 FOR I=0 TO 4
780   IF EF(I)=0 THEN GOTO 800
790   IF EY(I)>13 THEN EX(I)=INT(RND(1)*28)+2:EY(I)=1
800 NEXT I
810 :
820 REM -- HIT CHECK: BULLET vs ENEMY --
830 IF BF=0 THEN GOTO 900
840 FOR I=0 TO 4
850   IF EF(I)=0 THEN GOTO 880
860   IF ABS(BX-EX(I))<=1 AND ABS(BY-EY(I))<=1 THEN GOSUB 7000:SCORE=SCORE+10*LEVEL:BF=0:EX(I)=INT(RND(1)*28)+2:EY(I)=1
870   GOTO 880
880 NEXT I
890 :
900 REM -- HIT CHECK: ENEMY vs PLAYER --
910 FOR I=0 TO 4
920   IF EF(I)=0 THEN GOTO 950
930   IF ABS(EX(I)-PX)<=1 AND EY(I)>=PY-1 THEN GOSUB 7100:LIVES=LIVES-1:EX(I)=INT(RND(1)*28)+2:EY(I)=1
940   IF LIVES<=0 THEN GOTO 4000
950 NEXT I
960 :
1000 REM -- DRAW ENEMIES --
1010 COLOR 5,0
1020 FOR I=0 TO 4
1030   IF EF(I)=0 THEN GOTO 1050
1040   LOCATE EX(I),EY(I):PRINT "W"
1050 NEXT I
1060 :
1070 REM -- DRAW BULLET --
1080 COLOR 7,0
1090 IF BF=1 THEN LOCATE BX,BY:PRINT "|"
1100 :
1110 REM -- DRAW PLAYER --
1120 COLOR 6,0
1130 LOCATE PX,PY:PRINT "A"
1140 :
1150 REM -- DRAW STATUS BAR --
1160 COLOR 7,0
1170 LOCATE 0,15:PRINT "SC:";SCORE;"  LV:";LEVEL;"  "
1180 LOCATE 22,15:PRINT "LIFE:"
1190 FOR L=1 TO LIVES
1200   LOCATE 22+4+L,15:PRINT "A"
1210 NEXT L
1220 FOR L=LIVES+1 TO 3
1230   LOCATE 22+4+L,15:PRINT " "
1240 NEXT L
1250 :
1260 REM -- LEVEL UP --
1270 IF SCORE >= LEVEL*200 THEN LEVEL=LEVEL+1:GOSUB 8000
1280 :
1290 GOTO 510
1300 :
4000 REM === GAME OVER ===
4010 CLS
4020 COLOR 4,0
4030 LOCATE 9,4:PRINT "GAME OVER"
4040 LOCATE 7,5:PRINT "ゲームオーバー"
4050 COLOR 7,0
4060 LOCATE 6,7:PRINT "SCORE : ";SCORE
4070 LOCATE 6,8:PRINT "LEVEL : ";LEVEL
4080 COLOR 6,0
4090 IF SCORE>HISCORE THEN HISCORE=SCORE:LOCATE 4,10:PRINT "★ ニューレコード！ ★"
4100 COLOR 7,0
4110 LOCATE 3,12:PRINT "SPC:もういちど  Q:やめる"
4120 K$=INKEY$:IF K$=CHR$(32) THEN GOTO 300
4130 IF K$="Q" OR K$="q" THEN GOTO 5000
4140 GOTO 4120
4150 :
5000 REM === TITLE RETURN ===
5010 CLS
5020 GOTO 100
5030 :
6000 REM === ERASE PLAYER (MOVE LEFT) ===
6010 LOCATE PX,PY:PRINT " "
6020 RETURN
6030 :
6100 REM === ERASE PLAYER (MOVE RIGHT) ===
6110 LOCATE PX,PY:PRINT " "
6120 RETURN
6130 :
7000 REM === HIT EFFECT ===
7010 COLOR 7,0
7020 LOCATE EX(I),EY(I):PRINT "*"
7030 FOR T=1 TO 150:NEXT T
7040 LOCATE EX(I),EY(I):PRINT " "
7050 RETURN
7060 :
7100 REM === DAMAGE EFFECT ===
7110 COLOR 4,0
7120 LOCATE PX,PY:PRINT "X"
7130 FOR T=1 TO 300:NEXT T
7140 LOCATE PX,PY:PRINT " "
7150 RETURN
7160 :
8000 REM === LEVEL UP MESSAGE ===
8010 COLOR 6,0
8020 LOCATE 8,7:PRINT "LEVEL UP!  LV:";LEVEL
8030 FOR T=1 TO 500:NEXT T
8040 LOCATE 8,7:PRINT "                   "
8050 RETURN
