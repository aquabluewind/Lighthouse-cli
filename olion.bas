10 REM ****************************
20 REM *  O L I O N  オリオン   *
30 REM *  3D STAR FIGHTER         *
40 REM *  NEC PC-6001 N60-BASIC   *
50 REM ****************************
60 SCREEN 2:CLS
70 :
80 REM === TITLE SCREEN ===
90 COLOR 3
100 LOCATE 8,2:PRINT "** OLION **"
110 LOCATE 5,3:PRINT "オリオン ファイター"
120 COLOR 2
130 LOCATE 3,6:PRINT "Z / X  : ひだり・みぎ"
140 LOCATE 3,7:PRINT "U / D  : うえ・した"
150 LOCATE 3,8:PRINT "  SPC  : ハッシャ"
160 COLOR 1
170 LOCATE 3,10:PRINT "じくうに ただよう てきを"
180 LOCATE 3,11:PRINT "じゅうじせんに いれて うて！"
190 COLOR 3
200 LOCATE 7,13:PRINT "SPC:スタート"
210 K$=INKEY$:IF K$<>CHR$(32) THEN 210
220 CLS
230 :
240 REM === INITIALIZE ===
250 PT=0:LV=3:KL=0:GS=1
260 PX=0:PY=0:PVX=0:PVY=0
270 FC=0
280 :
290 REM --- STARS ---
300 NS=15
310 DIM SX(15),SY(15)
320 FOR I=0 TO NS-1
330   SX(I)=RND(1)*140+10
340   SY(I)=RND(1)*60+5
350 NEXT I
360 :
370 REM --- ENEMIES ---
380 NE=3
390 DIM EX(3),EY(3),EZ(3),EV(3)
400 DIM OX(3),OY(3),OS(3)
410 FOR I=0 TO NE-1
420   EX(I)=RND(1)*60-30
430   EY(I)=RND(1)*40-20
440   EZ(I)=RND(1)*50+80
450   EV(I)=1
460   OX(I)=-1
470 NEXT I
480 :
490 REM === DRAW COCKPIT FRAME (static) ===
500 LINE(0,71)-(159,71),3
510 LINE(0,71)-(20,99),3
520 LINE(159,71)-(140,99),3
530 LINE(50,71)-(55,99),3
540 LINE(110,71)-(105,99),3
550 LINE(20,88)-(55,99),3
560 LINE(140,88)-(105,99),3
570 LINE(55,92)-(105,92),3
580 LINE(55,92)-(60,99),3
590 LINE(105,92)-(100,99),3
600 :
610 REM === DRAW CROSSHAIR ===
620 LINE(73,35)-(77,35),3
630 LINE(83,35)-(87,35),3
640 LINE(80,28)-(80,32),3
650 LINE(80,38)-(80,42),3
660 :
670 REM === MAIN LOOP ===
680 K$=INKEY$
690 :
700 REM -- PLAYER AIM INPUT --
710 IF K$="Z" OR K$="z" THEN PVX=PVX-0.7
720 IF K$="X" OR K$="x" THEN PVX=PVX+0.7
730 IF K$="U" OR K$="u" THEN PVY=PVY-0.5
740 IF K$="D" OR K$="d" THEN PVY=PVY+0.5
750 PVX=PVX*0.78:PVY=PVY*0.78
760 PX=PX+PVX:PY=PY+PVY
770 IF PX<-45 THEN PX=-45:PVX=0
780 IF PX>45 THEN PX=45:PVX=0
790 IF PY<-35 THEN PY=-35:PVY=0
800 IF PY>35 THEN PY=35:PVY=0
810 :
820 REM -- FIRE --
830 FC=FC-1:IF FC<0 THEN FC=0
840 IF K$=CHR$(32) AND FC=0 THEN GOSUB 6000:FC=18
850 :
860 REM -- ERASE STARS --
870 FOR I=0 TO NS-1
880   PSET(INT(SX(I)),INT(SY(I))),0
890 NEXT I
900 :
910 REM -- ERASE ENEMIES --
920 FOR EI=0 TO NE-1
930   IF OX(EI)<0 THEN GOTO 980
940   TX=OX(EI):TY=OY(EI):TS=OS(EI)
950   LINE(TX,TY-TS)-(TX+TS,TY),0
960   LINE(TX+TS,TY)-(TX,TY+TS),0
970   LINE(TX,TY+TS)-(TX-TS,TY),0:LINE(TX-TS,TY)-(TX,TY-TS),0
980 NEXT EI
990 :
1000 REM -- MOVE STARS (zoom from center) --
1010 FOR I=0 TO NS-1
1020   DX=SX(I)-80:DY=SY(I)-36
1030   SX(I)=SX(I)+DX*0.05:SY(I)=SY(I)+DY*0.05
1040   IF SX(I)<2 OR SX(I)>157 OR SY(I)<2 OR SY(I)>68 THEN SX(I)=79+RND(1)*3:SY(I)=35+RND(1)*3
1050 NEXT I
1060 :
1070 REM -- MOVE ENEMIES CLOSER --
1080 FOR EI=0 TO NE-1
1090   IF EV(EI)=0 THEN GOTO 1130
1100   EZ(EI)=EZ(EI)-0.6*GS
1110   IF EZ(EI)<8 THEN GOSUB 7200:LV=LV-1:EX(EI)=RND(1)*60-30:EY(EI)=RND(1)*40-20:EZ(EI)=RND(1)*50+90:OX(EI)=-1:IF LV<=0 THEN GOTO 5000
1130 NEXT EI
1140 :
1150 REM -- DRAW STARS --
1160 FOR I=0 TO NS-1
1170   PSET(INT(SX(I)),INT(SY(I))),1
1180 NEXT I
1190 :
1200 REM -- DRAW ENEMIES --
1210 FOR EI=0 TO NE-1
1220   IF EV(EI)=0 THEN OX(EI)=-1:GOTO 1300
1230   SC=40/EZ(EI)
1240   TX=INT(80+(EX(EI)-PX)*SC)
1250   TY=INT(36+(EY(EI)-PY)*SC)
1260   TS=INT(8*SC)
1270   IF TS<1 THEN TS=1
1280   IF TS>22 THEN TS=22
1290   IF TX<6 OR TX>153 OR TY<6 OR TY>64 THEN OX(EI)=-1:GOTO 1300
1291   CO=2:IF EZ(EI)<25 THEN CO=3
1292   LINE(TX,TY-TS)-(TX+TS,TY),CO
1293   LINE(TX+TS,TY)-(TX,TY+TS),CO
1294   LINE(TX,TY+TS)-(TX-TS,TY),CO
1295   LINE(TX-TS,TY)-(TX,TY-TS),CO
1296   OX(EI)=TX:OY(EI)=TY:OS(EI)=TS
1300 NEXT EI
1310 :
1320 REM -- STATUS --
1330 LOCATE 0,0:PRINT "SC:";PT;"   "
1340 LOCATE 14,0:PRINT "LV:";LV
1350 LOCATE 25,0:PRINT "KL:";KL
1360 :
1370 GOTO 680
1380 :
5000 REM === GAME OVER ===
5010 CLS
5020 COLOR 1
5030 LOCATE 9,4:PRINT "GAME OVER"
5040 LOCATE 7,5:PRINT "ゲームオーバー"
5050 COLOR 3
5060 LOCATE 6,7:PRINT "SCORE :";PT
5070 LOCATE 6,8:PRINT "KILLS :";KL
5080 COLOR 2
5090 LOCATE 3,11:PRINT "SPC:もういちど  Q:やめる"
5100 K$=INKEY$:IF K$=CHR$(32) THEN RUN
5110 IF K$="Q" OR K$="q" THEN CLS:SCREEN 0:END
5120 GOTO 5100
5130 :
6000 REM === FIRE BULLET ===
6005 HT=0
6010 FOR EI=0 TO NE-1
6020   IF EV(EI)=0 OR HT=1 THEN GOTO 6080
6030   SC=40/EZ(EI)
6040   TX=INT(80+(EX(EI)-PX)*SC)
6050   TY=INT(36+(EY(EI)-PY)*SC)
6060   IF ABS(TX-80)<13 AND ABS(TY-36)<11 THEN GOSUB 7000:EV(EI)=0:PT=PT+100:KL=KL+1:HT=1
6080 NEXT EI
6090 IF HT=0 THEN PSET(80,36),3:FOR T=1 TO 40:NEXT T:PSET(80,36),0
6095 RETURN
6100 :
7000 REM === EXPLOSION ===
7010 FOR R=2 TO 20 STEP 3
7020   LINE(TX-R,TY)-(TX+R,TY),3
7030   LINE(TX,TY-R)-(TX,TY+R),3
7040   FOR T=1 TO 40:NEXT T
7050 NEXT R
7060 FOR R=20 TO 2 STEP -3
7070   LINE(TX-R,TY)-(TX+R,TY),0
7080   LINE(TX,TY-R)-(TX,TY+R),0
7090 NEXT R
7100 GS=1+KL/6:IF GS>4 THEN GS=4
7110 EX(EI)=RND(1)*60-30:EY(EI)=RND(1)*40-20:EZ(EI)=RND(1)*50+90:EV(EI)=1:OX(EI)=-1
7120 RETURN
7130 :
7200 REM === ENEMY PASSED - DAMAGE ===
7210 LOCATE 8,8:PRINT "!! HIT !!"
7220 FOR T=1 TO 600:NEXT T
7230 LOCATE 8,8:PRINT "         "
7240 RETURN
